# Maestro — облачный движок генерации. Скопировать в .env и заполнить.
# Ключи также задаются в UI: Настройки → Cloud (пишутся в .env).

# Где генерировать: local (локальные модели) | minimax | fal | muapi
CLOUD_PROVIDER=fal

# Видеодвижок облака: wan22 (Wan 2.2 на fal, основной) | h3 (MiniMax H3)
CLOUD_VIDEO_ENGINE=wan22

# --- MiniMax API: видео MiniMax-H3 (/v2/video_generation), картинки MiniMax-H3-Image ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_IMAGE_MODEL=MiniMax-H3-Image

# --- fal: основной видеодвижок Wan 2.2 выбирается сам (CLOUD_VIDEO_ENGINE=wan22).
# FAL_VIDEO_MODEL / FAL_T2V_MODEL — запасной MiniMax H3 (длинные ролики, если Wan недоступен) ---
FAL_KEY=
FAL_VIDEO_MODEL=minimax/h3/image-to-video
FAL_T2V_MODEL=minimax/h3/text-to-video
FAL_IMAGE_MODEL=fal-ai/moss-image

# --- MuAPI: minimax-h3-*, qwen2-1-image-to-image ---
MUAPI_API_KEY=
MUAPI_VIDEO_MODEL=minimax-h3-image-to-video
MUAPI_T2V_MODEL=minimax-h3-text-to-video
MUAPI_IMAGE_MODEL=minimax-h3-image
MUAPI_EDIT_MODEL=qwen2-1-image-to-image

# --- Облачная LLM для Director и встроенного помощника ---
# Используется, когда CLOUD_PROVIDER не local и в Настройках LLM выбран Local.
# Помощник берёт тот же ключ. Если LLM_MODEL пустой, он использует
# nvidia/nemotron-3.5-lightning:free, запасная модель z-ai/glm-5.3-flash.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
